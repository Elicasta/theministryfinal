{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theministry.vercel.app/content/lesson.schema.json",
  "title": "The Ministry Unified Lesson",
  "type": "object",
  "required": [
    "id",
    "series",
    "title",
    "scripture",
    "slides"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "type": "string",
      "minLength": 1
    },
    "seriesSlug": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scripture": {
      "type": "string"
    },
    "taughtAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "theme": {
      "enum": [
        "evidence",
        "ministry",
        "principles",
        "purpose",
        "default"
      ]
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "cover",
              "verse",
              "statement",
              "prompt",
              "points",
              "contrast",
              "steps",
              "check",
              "levels",
              "columns",
              "progression",
              "illustration"
            ]
          },
          "kicker": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "sub": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "es": {
            "type": "object"
          }
        }
      }
    },
    "verses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "text"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "ref_en": {
            "type": "string"
          },
          "text_en": {
            "type": "string"
          },
          "ref_es": {
            "type": "string"
          },
          "text_es": {
            "type": "string"
          }
        }
      }
    },
    "polls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "cue": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "es": {
            "type": "object"
          }
        }
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "manuscript": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "translations": {
      "type": "object",
      "properties": {
        "es": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    }
  }
}
